[Unit]
Description=TWO 26 Selective Commitment Streaming ASR - Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Selective_Commitment_Streaming_Speech_to_Text/backend
Environment="PATH=/home/ubuntu/Selective_Commitment_Streaming_Speech_to_Text/backend/venv/bin:/home/ubuntu/Selective_Commitment_Streaming_Speech_to_Text/venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/bin/bash -c "if [ -f /home/ubuntu/Selective_Commitment_Streaming_Speech_to_Text/backend/venv/bin/uvicorn ]; then exec /home/ubuntu/Selective_Commitment_Streaming_Speech_to_Text/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --lifespan on; else exec /home/ubuntu/Selective_Commitment_Streaming_Speech_to_Text/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --lifespan on; fi"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
